# Máximo tamaño del archivo a enviar por WhatsApp (en MB)
MAX_FILE_SIZE_MB=60

# Número máximo de descargas simultáneas (1 recomendado para ahorrar RAM)
MAX_CONCURRENT_DOWNLOADS=1

# Buffer máximo para proceso ffmpeg (en MB)
FFMPEG_MAX_BUFFER_MB=4

# Ruta de datos de sesión de WhatsApp (opcional)
SESSION_PATH=.session

# Si está en true, si falla el envío como video se intentará enviar como documento
# Por defecto, se deja en false para priorizar video reproducible en chat
ALLOW_DOCUMENT_FALLBACK=false

# Si está en true, conserva los archivos descargados en temp/
# Si está en false, borra el video al finalizar el envío
KEEP_DOWNLOADED_FILES=false

# Numeros de celular bloqueados para usar el bot (separados por coma, espacios o ;)
# Ejemplo: BLOCKED_NUMBERS=5491111111111,5492222222222
BLOCKED_NUMBERS=51955052062

# IDs de WhatsApp bloqueados (util para casos @lid). Separados por coma, espacios o ;
# Ejemplo: BLOCKED_IDS=257324761481443@lid
BLOCKED_IDS=

# Si está en true, muestra en consola el numero detectado para depurar bloqueos
BLOCKED_DEBUG=false

# URL de imagen predeterminada para el comando .menu
# Ejemplo: MENU_IMAGE_URL=https://i.imgur.com/tu-banner.jpg
MENU_IMAGE_URL=https://www.infobae.com/resizer/v2/U6IUYLBP2ZBVVNQFXE4LNQSENY.jpg?auth=2689e40504fa9a29c77e81b136545860e0fd4fc483d72918a021a5b29937b852&smart=true&width=350&height=197&quality=85

# Si está en true, guarda automáticamente cada búsqueda .r34 en src/Documents como TXT
# Si está en false, no guarda archivos TXT de búsquedas r34
SAVE_R34_SEARCHES=true

# Tags/fragments bloqueados para .r34 (separados por coma o espacios)
# Ejemplo: R34_EXCLUDED_TAGS=futa loli shota
R34_EXCLUDED_TAGS=futa ai_generated

# r34 API (para comando .r34/#r34)
R34_API_BASE_URL=https://api.rule34.xxx
R34_USER_ID=5991278
R34_API_KEY=6a8d55a56d36e5a2d39ac2e8ffcdba9467d9d674e5bb4198edfb78dcb65b71e37effc2eeba6269ab41eed39d1bef308d3d3b58530bd35c10c6dcc99e165f38d3
